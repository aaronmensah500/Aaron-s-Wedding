# =============================================================================
# Wedding site — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Naming:
#   PUBLIC_*  → embedded in the browser bundle; must be safe to expose.
#   (no prefix) → server-only (API routes, SSR); never use PUBLIC_ for secrets.
#
# After editing: restart `npm run dev` so Astro/Vite reloads env.
# =============================================================================

# -----------------------------------------------------------------------------
# Canonical site URL (HTTPS, no trailing slash)
# -----------------------------------------------------------------------------
# Used for: guest QR codes (RSVP + registry), calendar .ics description link,
#           and primary magic-link redirect target.
#
# Example shape:
#   PUBLIC_SITE_URL=https://wedding.example.com
PUBLIC_SITE_URL=

# Optional server fallback if PUBLIC_SITE_URL is missing (magic-link API only).
# Same shape as above; usually identical to PUBLIC_SITE_URL.
DOMAIN=

# -----------------------------------------------------------------------------
# Supabase (RSVP POST /api/rsvp, guest magic link /api/auth/magic-link, portal)
# -----------------------------------------------------------------------------
# Dashboard → Project Settings → API
#
# Project URL (always https, ends with .supabase.co):
#   PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
PUBLIC_SUPABASE_URL=

# “anon” “public” JWT — long string starting with eyJ…
#   PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ij…
PUBLIC_SUPABASE_ANON_KEY=

# “service_role” JWT — server only; never PUBLIC_. Required for API routes.
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ij…
SUPABASE_SERVICE_ROLE_KEY=

# Auth checklist (Supabase Dashboard → Authentication):
#   - Turn OFF “Allow new users to sign up” (guests are created when they RSVP).
#   - Redirect URLs: http://localhost:4324/ and your production site (e.g. https://wedding.example.com/).

# -----------------------------------------------------------------------------
# Paystack (registry “Contribute” inline checkout)
# -----------------------------------------------------------------------------
# Dashboard → Settings → API Keys & Webhooks
#
# Public key — safe in the browser; starts with pk_test_ or pk_live_
#   PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_0123456789abcdef0123456789abcdef
PUBLIC_PAYSTACK_PUBLIC_KEY=

# Secret key — server only; starts with sk_test_ or sk_live_. Never prefix with PUBLIC_
# Required for gift recording (/api/gifts/record) and Paystack webhooks.
#   PAYSTACK_SECRET_KEY=sk_test_0123456789abcdef0123456789abcdef
PAYSTACK_SECRET_KEY=

# Paystack Dashboard → Settings → API Keys & Webhooks → Add webhook URL:
#   https://your-domain.com/api/paystack/webhook
# Event: charge.success

# Optional ISO currency override (otherwise site content default, e.g. GHS).
# Common: GHS, NGN, USD (must match what your Paystack account supports)
#   PUBLIC_PAYSTACK_CURRENCY=GHS
PUBLIC_PAYSTACK_CURRENCY=

# -----------------------------------------------------------------------------
# MapTiler (optional — Details section interactive map basemap)
# -----------------------------------------------------------------------------
# If unset, the map falls back to Esri World Street Map tiles. With key + MapTiler map id
# in site content, raster tiles load from MapTiler. Free keys work with standard ids (e.g.
# streets-v4); custom Cloud map UUIDs may return 403 unless your plan allows them. Add your
# site origins to the key’s HTTP referrer allowlist (include http://localhost:4324 for dev).
#
# Example (opaque token string from MapTiler Cloud):
#   PUBLIC_MAPTILER_API_KEY=get_your_own_key_at_maptiler_com
PUBLIC_MAPTILER_API_KEY=

# -----------------------------------------------------------------------------
# Site editor (optional — production only; dev always shows editor)
# -----------------------------------------------------------------------------
# Set PUBLIC_SHOW_SITE_EDITOR=true on staging if you want the editor + launcher without `?admin=1`.
# On the live site you can omit this and open the editor with: https://your-domain/?admin=1 (PIN still required).
# Omit or set false if you never want the editor bundle active without that URL flag.
#
#   PUBLIC_SHOW_SITE_EDITOR=false
PUBLIC_SHOW_SITE_EDITOR=

# If true AND editor is shown on production: hide the floating launcher; open
# editor via ?admin=1 or Alt+Shift+E.
#
#   PUBLIC_HIDE_SITE_EDITOR_LAUNCHER=false
PUBLIC_HIDE_SITE_EDITOR_LAUNCHER=

# -----------------------------------------------------------------------------
# Admin image upload (optional — enables file upload in the site editor)
# -----------------------------------------------------------------------------
# A random secret that gates the POST /api/admin/upload endpoint.
# Because it must be readable by the browser editor it is PUBLIC_; treat it
# like a password — keep it long, random, and out of version control.
#
# Generate one: openssl rand -hex 24
#
# Also required: create the `admin-media` Supabase Storage bucket by running
#   supabase/migrations/20260514000000_admin_media_bucket.sql
# in your Supabase SQL editor. PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# must also be set.
#
#   PUBLIC_ADMIN_UPLOAD_TOKEN=your_random_hex_token_here
PUBLIC_ADMIN_UPLOAD_TOKEN=

# -----------------------------------------------------------------------------
# Site content publishing (editor → all visitors)
# -----------------------------------------------------------------------------
# Required for edits in the site editor to reach every guest (not just this browser).
# Run supabase/migrations/20260514120000_wedding_site_content.sql in your project.
# Generate: openssl rand -hex 24
#
#   PUBLIC_SITE_CONTENT_SAVE_TOKEN=your_random_hex_token_here
PUBLIC_SITE_CONTENT_SAVE_TOKEN=
