# =============================================================================
# Wedding site — environment variables (production template)
# =============================================================================
# Copy to `.env` for local work only. For live hosting, set these in your
# platform dashboard (Vercel, Railway, etc.) — do not commit `.env`.
#
# Naming:
#   PUBLIC_*     → embedded in the browser bundle; safe to expose by design.
#   (no prefix)  → server-only; never prefix secrets with PUBLIC_.
#
# Production checklist:
#   - Use live Paystack keys (pk_live_ / sk_live_) on the deployed site.
#   - Paystack webhook: https://YOUR_DOMAIN/api/paystack/webhook (charge.success).
#   - Paystack live callback URL: not used (inline checkout; no redirect).
#   - Supabase Auth → redirect allowlist: https://YOUR_DOMAIN/ (and localhost for dev).
#   - Disable public sign-up in Supabase (guests come from RSVP).
#
# After changing env locally: restart `npm run dev`.
# =============================================================================

# -----------------------------------------------------------------------------
# Canonical site URL (HTTPS, no trailing slash)
# -----------------------------------------------------------------------------
PUBLIC_SITE_URL=

# Optional server fallback if PUBLIC_SITE_URL is unset (magic-link API only).
DOMAIN=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Paystack (registry — production)
# -----------------------------------------------------------------------------
# Dashboard → Settings → API Keys & Webhooks
# Use pk_live_ / sk_live_ on production. Test keys (pk_test_ / sk_test_) are for local dev only.
PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Webhook (required for reliable gift recording if the browser closes early):
#   https://YOUR_DOMAIN/api/paystack/webhook
# Subscribe to: charge.success

# Optional ISO currency (must match your Paystack account), e.g. GHS, NGN, USD
PUBLIC_PAYSTACK_CURRENCY=

# -----------------------------------------------------------------------------
# MapTiler (optional — interactive map basemap)
# -----------------------------------------------------------------------------
# Unset = Esri fallback. Restrict key by HTTP referrer (production + localhost dev).
PUBLIC_MAPTILER_API_KEY=

# -----------------------------------------------------------------------------
# Site editor (production)
# -----------------------------------------------------------------------------
# Omit or false on the public site; open editor with ?admin=1 (PIN required).
PUBLIC_SHOW_SITE_EDITOR=false
# If editor is enabled: hide floating launcher; use ?admin=1 or Alt+Shift+E.
PUBLIC_HIDE_SITE_EDITOR_LAUNCHER=false

# -----------------------------------------------------------------------------
# Admin image upload (site editor PIN — not an env secret)
# -----------------------------------------------------------------------------
# Uploads use the PIN from published site content via POST /api/admin/upload.
# Run: supabase/migrations/20260514000000_admin_media_bucket.sql
# Requires PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.

# Optional legacy override (prefer editor PIN; leave unset if unused):
# PUBLIC_ADMIN_UPLOAD_TOKEN=

# -----------------------------------------------------------------------------
# Site content publishing (editor → all visitors)
# -----------------------------------------------------------------------------
# Run: supabase/migrations/20260514120000_wedding_site_content.sql
# Publishing uses the editor PIN (re-entered on “Save for everyone”). No env token required.
# Optional legacy Bearer override (leave unset):
# PUBLIC_SITE_CONTENT_SAVE_TOKEN=
