# Optional: show the floating “Edit site” + “Tweaks” UI on a production build.
# Leave unset (or not "true") on the public wedding URL so guests never see the editor.
# Local `npm run dev` always shows the editor.
# PUBLIC_SHOW_SITE_EDITOR=true
#
# With the editor enabled on production, hide the visible launcher so guests don’t see it.
# Couple opens: https://yoursite.com/?admin=1  (PIN gate, or auto-open if “Require PIN” is off)
# After unlocking in a browser, use Alt+Shift+E to toggle the editor if the button stays hidden.
# PUBLIC_HIDE_SITE_EDITOR_LAUNCHER=true

# Supabase (RSVP API, guest magic-link login, uploads). Run supabase/migrations/*.sql in the project SQL editor.
# Copy to `.env` and fill with values from Supabase Dashboard → Project Settings → API.
# PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only — never commit real keys or put them in this example file
# Production site (HTTPS, no trailing slash). Required for correct QR codes & magic-link redirects in production.
# PUBLIC_SITE_URL=https://your-domain.com
# Optional duplicate for server-only fallbacks (magic-link API reads PUBLIC_SITE_URL first, then DOMAIN).
# DOMAIN=https://your-domain.com

# In Supabase Dashboard → Authentication: turn OFF “Allow new users to sign up” (accounts are created when guests RSVP).
# Add redirect URLs: http://localhost:4324/ and your production origin.

# MapTiler — same map id as your embed URL; key loads raster tiles for the interactive Details map (pins + guest location).
# PUBLIC_MAPTILER_API_KEY=your_key_here

# Paystack (registry contributions). Public key only — safe in the browser. Secret key stays in Paystack Dashboard for webhooks.
# PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx   # server only — never use PUBLIC_ prefix (it would leak to the browser bundle)
# Optional override; otherwise uses `registry.payCurrencyCode` in site content (default GHS).
# PUBLIC_PAYSTACK_CURRENCY=GHS